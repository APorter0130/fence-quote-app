# Copy this file to .env.local for local development.
# In production, add the same names as environment variables in your host (for example Vercel).
# Never commit real values.

# ── Supabase (Project Settings → API) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret. NEVER give this a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# ── Maps ─────────────────────────────────────────────────────────────────────
# Public Mapbox token. Restrict it to your own domains in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Optional: parcel boundary lookup (Regrid). Leave empty to skip.
REGRID_API_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend, e.g. quotes@yourdomain.com
RESEND_FROM_EMAIL=
# Optional: receives an email whenever a contractor changes their pricing.
PRICING_AUDIT_EMAIL=

# ── Security ─────────────────────────────────────────────────────────────────
# Password for /admin. Use 12 or more characters; shorter values disable sign-in.
ADMIN_PASSWORD=
# Contractors need this code on /onboard. Leave empty to close signup completely.
SIGNUP_INVITE_CODE=
# Long random string used to sign embed links.
EMBED_SIGNING_SECRET=

# ── Embedding (optional) ─────────────────────────────────────────────────────
# Comma-separated list of sites allowed to embed the form when a contractor has not set their own.
NEXT_PUBLIC_IFRAME_PARENT_ORIGINS=
